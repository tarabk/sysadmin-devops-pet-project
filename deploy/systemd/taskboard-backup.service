[Unit]
Description=Taskboard PostgreSQL backup and Azure upload
Requires=postgresql.service
Wants=network-online.target
After=postgresql.service network-online.target

[Service]
Type=oneshot
User=postgres
Group=postgres
WorkingDirectory=/var/backups/taskboard
UMask=0077
ExecStart=/usr/local/sbin/taskboard-backup.sh
TimeoutStartSec=15min
